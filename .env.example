# Copy to .env and adjust. Every value here is a safe local default.
NEXUS_ENV=development
NEXUS_SECRET_KEY=change-me-to-a-long-random-string
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5433/nexus
NEXUS_REDIS_URL=redis://localhost:6380/0
NEXUS_DATA_DIR=./data

# LLM — local Ollama by default
NEXUS_LLM_PROVIDER=ollama
NEXUS_OLLAMA_URL=http://localhost:11434
NEXUS_CHAT_MODEL=qwen3:4b-instruct
NEXUS_EMBED_MODEL=nomic-embed-text

# Optional OpenAI-compatible endpoint (never used unless NEXUS_LLM_PROVIDER=openai_compat)
NEXUS_OPENAI_BASE_URL=
NEXUS_OPENAI_API_KEY=
NEXUS_OPENAI_MODEL=

# Web research
NEXUS_SEARCH_PROVIDER=searxng
NEXUS_SEARXNG_URL=http://localhost:8888

# Postgres container credentials (used by docker compose)
POSTGRES_PASSWORD=nexus
SEARXNG_SECRET=change-me-searxng-secret
